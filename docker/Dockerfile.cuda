# The CUDA + cuDNN runtime base lets the tagger load the CUDA execution
# provider; the binary still runs on CPU.

FROM golang:1.26.7-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN . ./packaging/release-env.sh && \
    CGO_ENABLED=1 go build -tags tagger \
    -ldflags="-s -w $LDFLAGS -X '$MOD.Package=docker' -X '$MOD.Variant=cuda'" \
    -o /monbooru ./cmd/monbooru

FROM nvidia/cuda:12.9.2-cudnn-runtime-ubuntu22.04

# Drops the CUDA forward-compat libs: the host driver comes in through the
# NVIDIA container runtime.
RUN apt-get update && apt-get upgrade -y && \
    apt-get remove -y --purge 'cuda-compat-*' && \
    rm -rf /usr/local/cuda/compat /var/lib/apt/lists/*

ARG ORT_VERSION=1.21.0
ARG ORT_SHA256_X64_GPU=ef37a33ba75e457aebfd0d7b342ab20424aa6126bc5f565d247f1201b66996cf
ARG FFMPEG_BUILD=v8.1.2-mb4
ARG FFMPEG_NAME=ffmpeg-8.1.2-mb4
ARG FFMPEG_SHA256_LINUX64=66f8f4627e1cc9ad26caa9fcd9799e88db84711ef03c1565c923694804c11000
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils && \
    curl -fsSL "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-x64-gpu-${ORT_VERSION}.tgz" \
      -o /tmp/ort.tgz && \
    echo "${ORT_SHA256_X64_GPU}  /tmp/ort.tgz" | sha256sum -c - && \
    tar -xzf /tmp/ort.tgz -C /tmp && \
    cp /tmp/onnxruntime-linux-x64-gpu-${ORT_VERSION}/lib/libonnxruntime*.so* /usr/lib/ && \
    ln -sf /usr/lib/libonnxruntime.so.${ORT_VERSION} /usr/lib/libonnxruntime.so && \
    ldconfig && \
    curl -fsSL "https://github.com/monbooru/ffmpeg-builds/releases/download/${FFMPEG_BUILD}/${FFMPEG_NAME}-linux64.tar.xz" -o /tmp/ffmpeg.tar.xz && \
    echo "${FFMPEG_SHA256_LINUX64}  /tmp/ffmpeg.tar.xz" | sha256sum -c - && \
    mkdir -p /tmp/ff && tar -xJf /tmp/ffmpeg.tar.xz -C /tmp/ff --strip-components=1 && \
    cp /tmp/ff/bin/ffmpeg /tmp/ff/bin/ffprobe /usr/local/bin/ && \
    mkdir -p /usr/share/doc/onnxruntime /usr/share/doc/ffmpeg && \
    cp /tmp/onnxruntime-linux-x64-gpu-${ORT_VERSION}/LICENSE \
       /tmp/onnxruntime-linux-x64-gpu-${ORT_VERSION}/ThirdPartyNotices.txt /usr/share/doc/onnxruntime/ && \
    cp /tmp/ff/licenses/* /usr/share/doc/ffmpeg/ && \
    apt-get purge -y curl xz-utils && apt-get autoremove -y && \
    rm -rf /tmp/onnxruntime-* /tmp/ort.tgz /tmp/ff /tmp/ffmpeg.tar.xz /var/lib/apt/lists/*

COPY --from=build /monbooru /usr/local/bin/monbooru

# Build a uid/gid 1000 "monbooru" account
RUN groupadd --gid 1000 monbooru && \
    useradd --uid 1000 --gid 1000 --home-dir /home/monbooru --create-home monbooru
USER 1000:1000

ENV MONBOORU_SERVER_BIND_ADDRESS=0.0.0.0:8455
ENV MONBOORU_CONTAINER=1
EXPOSE 8455

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/usr/local/bin/monbooru", "healthcheck", "-config", "/config/monbooru.toml"]

ENTRYPOINT ["/usr/local/bin/monbooru", "-config", "/config/monbooru.toml"]
