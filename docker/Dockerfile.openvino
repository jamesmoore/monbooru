# The base carries the Intel GPU user-mode stack (intel-opencl-icd,
# intel-level-zero-gpu); the ORT wheel below bundles its own OpenVINO.

FROM golang:1.26.7-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN . ./packaging/release-env.sh && \
    CGO_ENABLED=1 go build -tags tagger \
    -ldflags="-s -w $LDFLAGS -X '$MOD.Package=docker' -X '$MOD.Variant=openvino'" \
    -o /monbooru ./cmd/monbooru

FROM openvino/ubuntu22_runtime:2026.3.1
USER root
COPY --from=build /monbooru /usr/local/bin/monbooru

ARG FFMPEG_BUILD=v8.1.2-mb4
ARG FFMPEG_NAME=ffmpeg-8.1.2-mb4
ARG FFMPEG_SHA256_LINUX64=66f8f4627e1cc9ad26caa9fcd9799e88db84711ef03c1565c923694804c11000
RUN apt-get update && apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils && \
    curl -fsSL "https://github.com/monbooru/ffmpeg-builds/releases/download/${FFMPEG_BUILD}/${FFMPEG_NAME}-linux64.tar.xz" -o /tmp/ffmpeg.tar.xz && \
    echo "${FFMPEG_SHA256_LINUX64}  /tmp/ffmpeg.tar.xz" | sha256sum -c - && \
    mkdir -p /tmp/ff && tar -xJf /tmp/ffmpeg.tar.xz -C /tmp/ff --strip-components=1 && \
    cp /tmp/ff/bin/ffmpeg /tmp/ff/bin/ffprobe /usr/local/bin/ && \
    mkdir -p /usr/share/doc/ffmpeg && cp /tmp/ff/licenses/* /usr/share/doc/ffmpeg/ && \
    apt-get purge -y curl xz-utils && apt-get autoremove -y && \
    rm -rf /tmp/ff /tmp/ffmpeg.tar.xz /var/lib/apt/lists/*

# Upstream ships no OpenVINO tarball, so the PyPI wheel is the only
# prebuilt source. Pinned: an unpinned resolve follows the base's Python
# and takes the newest cp310 wheel.
ARG ORT_OPENVINO_VERSION=1.23.0

# Link the whole capi directory, not just libonnxruntime.so: the provider
# library pulls in the wheel's bundled OpenVINO by soname.
RUN pip install --no-cache-dir -U pip && \
    pip install --no-cache-dir onnxruntime-openvino==${ORT_OPENVINO_VERSION} && \
    PKG_DIR=$(python3 -c "import onnxruntime, os; print(os.path.dirname(onnxruntime.__file__))") && \
    find "$PKG_DIR" -name "*.so*" -type f -exec ln -sf {} /usr/local/lib/ \; && \
    ORT_FILE=$(find "$PKG_DIR" -name "libonnxruntime.so.*" | head -1) && \
    ln -sf "$ORT_FILE" /usr/local/lib/libonnxruntime.so && \
    ldconfig

# uid 1000 is the base image's own openvino user, homed at /home/openvino;
# HOME below moves it, so the directory has to exist and be owned first.
RUN mkdir -p /home/monbooru && chown 1000:1000 /home/monbooru

USER 1000:1000

ENV HOME=/home/monbooru \
    MONBOORU_SERVER_BIND_ADDRESS=0.0.0.0:8455 \
    MONBOORU_CONTAINER=1

EXPOSE 8455

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/usr/local/bin/monbooru", "healthcheck", "-config", "/config/monbooru.toml"]

ENTRYPOINT ["/usr/local/bin/monbooru", "-config", "/config/monbooru.toml"]
